{
  "name": "stepfun-mini-kb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "seekdb": "^1.4.0",
    "vite": "^6.4.5"
  },
  "description": "seekdb × 阶跃星辰：浏览器端侧 embedding + seekdb 混合检索的迷你知识库",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "demo": "npm run build && npm run start",
    "model:fetch": "node scripts/fetch-models.mjs",
    "model:quantize": ".venv/bin/python scripts/quantize.py",
    "corpus": "node scripts/build-corpus.mjs",
    "eval": ".venv/bin/python scripts/eval_retrieval.py",
    "bench": "node scripts/bench-browser.mjs",
    "smoke": "node scripts/smoke.mjs",
    "seed": "node scripts/seed-demo.mjs",
    "bench:batch": "node scripts/batch-ab.mjs",
    "bench:fp32": "EMBED_DTYPE=fp32 node scripts/bench-browser.mjs --only wasm"
  },
  "devDependencies": {
    "playwright-core": "^1.49.1"
  }
}
