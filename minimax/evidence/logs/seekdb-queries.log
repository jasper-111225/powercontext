[2026-10-28T01:08:59+08:00] INSERT INTO chunks (doc_id, project, kind, rel_path, symbol, title, line_start, line_end, content, content_hash, updated_at) VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)  -- params=["21", "minimart", "spec", "specs/REQ-001-order-query.md", "REQ-001.1 状态筛选", "REQ-001.1 状态筛选", "8", "12", "## REQ-001.1 状态筛选\n\n`list_orders(status=...)` 可选参数，用于按订单状态筛选。合法取值：`draft`、`paid`、`shipped`、`cancelled`。\n传入其他值必须抛出 `ValidationError`。传入 `None` 或仅含空白的字符串表示不按状态筛选。\n", "6516484ede1207eca3d6510853c358f0c7a7dffe317275ed6dd9134b9be5b971", "2026-10-28 01:08:59"]
