[2026-10-28T01:14:06+08:00] SELECT c.id, c.rel_path, c.symbol, c.title, c.line_start, c.line_end, c.content, GROUP_CONCAT(r.req_id ORDER BY r.req_id) AS reqs FROM chunks c JOIN chunk_reqs r ON r.chunk_id = c.id WHERE c.project = %s AND c.kind = %s AND r.req_id IN (%s, %s, %s, %s, %s, %s, %s) GROUP BY c.id, c.rel_path, c.symbol, c.title, c.line_start, c.line_end, c.content ORDER BY c.rel_path, c.line_start  -- params=["minimart", "code", "REQ-001", "REQ-001.1", "REQ-001.2", "REQ-001.3", "REQ-001.4", "REQ-001.5", "REQ-002"]
[2026-10-28T01:14:06+08:00] SELECT c.id, c.rel_path, c.symbol, c.title, c.line_start, c.line_end, c.content, GROUP_CONCAT(r.req_id ORDER BY r.req_id) AS reqs FROM chunks c JOIN chunk_reqs r ON r.chunk_id = c.id WHERE c.project = %s AND c.kind = %s AND r.req_id IN (%s, %s, %s, %s, %s, %s, %s) GROUP BY c.id, c.rel_path, c.symbol, c.title, c.line_start, c.line_end, c.content ORDER BY c.rel_path, c.line_start  -- params=["minimart", "test", "REQ-001", "REQ-001.1", "REQ-001.2", "REQ-001.3", "REQ-001.4", "REQ-001.5", "REQ-002"]
