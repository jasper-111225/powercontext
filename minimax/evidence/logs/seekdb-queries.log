[2026-10-28T01:08:59+08:00] INSERT INTO chunks (doc_id, project, kind, rel_path, symbol, title, line_start, line_end, content, content_hash, updated_at) VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)  -- params=["21", "minimart", "spec", "specs/REQ-001-order-query.md", "REQ-001.4 排序稳定", "REQ-001.4 排序稳定", "23", "26", "## REQ-001.4 排序稳定\n\n筛选结果保持既有排序：`created_at` 降序；`created_at` 相同的订单按 `order_id` 降序。筛选不得打乱顺序。\n", "73757a98d2458c599edaf2017484b7ea76b24355f728ff534108f47d309df977", "2026-10-28 01:08:59"]
