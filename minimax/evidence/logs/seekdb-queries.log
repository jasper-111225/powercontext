[2026-10-28T01:08:42+08:00] INSERT INTO chunks (doc_id, project, kind, rel_path, symbol, title, line_start, line_end, content, content_hash, updated_at) VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)  -- params=["11", "minimart", "spec", "specs/REQ-001-order-query.md", "REQ-001 订单查询筛选", "REQ-001 订单查询筛选", "1", "7", "# REQ-001 订单查询筛选\n\n- 状态：active\n- 版本：1\n- 变更：新增\n- 负责模块：`src/minimart/service.py`（`OrderService.list_orders`）\n", "6d5a612726404ae1d94863f15a309d2ff6d865165f4eee9a69002b03f1b0f498", "2026-10-28 01:08:42"]
