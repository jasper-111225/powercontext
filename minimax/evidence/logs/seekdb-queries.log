[2026-10-28T01:08:59+08:00] INSERT INTO chunks (doc_id, project, kind, rel_path, symbol, title, line_start, line_end, content, content_hash, updated_at) VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)  -- params=["21", "minimart", "spec", "specs/REQ-001-order-query.md", "REQ-001.3 组合筛选与分页", "REQ-001.3 组合筛选与分页", "18", "22", "## REQ-001.3 组合筛选与分页\n\n状态与金额可以同时生效，结果同时满足两个条件。筛选在分页之前执行：`page` 与 `page_size` 的分页语义与\nREQ-002.2 一致，第 1 页从筛选后的第一条记录开始。\n", "02a86b24c6ac37e348eac7e235da165f407784858e9f1677fdd016d97805b09f", "2026-10-28 01:08:59"]
