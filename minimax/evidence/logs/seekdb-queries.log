[2026-10-28T01:14:06+08:00] SELECT c.id, c.doc_id, c.rel_path, c.symbol, c.title, c.line_start, c.line_end, c.content, c.updated_at, d.version, d.change_kind, MATCH(c.content) AGAINST (%s) AS score FROM chunks c JOIN documents d ON d.id = c.doc_id WHERE c.project = %s AND c.kind = 'spec' AND MATCH(c.content) AGAINST (%s) ORDER BY score DESC LIMIT %s  -- params=["为订单查询增加状态筛选与最低金额筛选：支持 status 与 min_total 参数，过滤后分页，保持创建时间倒序，并校验非法参数。", "minimart", "为订单查询增加状态筛选与最低金额筛选：支持 status 与 min_total 参数，过滤后分页，保持创建时间倒序，并校验非法参数。", "8"]
