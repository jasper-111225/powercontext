# 复制为 .env（后端不强制读取 .env；用 export 或 docker --env-file 都可）
# 本机跑后端时保持 127.0.0.1；后端进容器时改成 host.docker.internal

ECHO_DB_HOST=127.0.0.1
ECHO_DB_PORT=2881
ECHO_DB_USER=root
ECHO_DB_PASSWORD=
ECHO_DB_NAME=echo_tavern

# 任意 OpenAI 兼容 /v1/embeddings
ECHO_EMBED_BASE_URL=http://127.0.0.1:11434/v1
ECHO_EMBED_API_KEY=ollama
ECHO_EMBED_MODEL=qwen3-embedding:0.6b
ECHO_EMBED_DIM=1024

ECHO_TURN_LIMIT=6
ECHO_CONTEXT_MEMORIES=5
ECHO_HOST=0.0.0.0
ECHO_PORT=8765
