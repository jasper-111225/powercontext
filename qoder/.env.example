# 据典环境变量示例。复制为 .env 后按本机情况修改；不要提交真实密码或 token。
# seekdb（MySQL 协议）
JUDIAN_DB_HOST=127.0.0.1
JUDIAN_DB_PORT=2881
JUDIAN_DB_USER=root
JUDIAN_DB_PASSWORD=
JUDIAN_DB_NAME=judian

# Ollama（OpenAI 兼容接口）
JUDIAN_EMBED_BASE=http://127.0.0.1:11434
JUDIAN_EMBED_MODEL=qwen3-embedding:0.6b
JUDIAN_EMBED_DIM=1024
JUDIAN_EMBED_BATCH=4
JUDIAN_EMBED_TIMEOUT=180
JUDIAN_LLM_BASE=http://127.0.0.1:11434
JUDIAN_LLM_MODEL=qwen2.5:0.5b
JUDIAN_LLM_TIMEOUT=60
# 默认关闭：本地 CPU 上 0.5B 生成可能 >60s，导致问答超时；需要模型改写时再开
JUDIAN_LLM_ENABLED=false

# PowerContext 记忆（token 仅为本地演示占位值）
JUDIAN_POWERCONTEXT_URL=http://127.0.0.1:17430
JUDIAN_POWERCONTEXT_TOKEN=judian-local-token
JUDIAN_MEMORY_TIMEOUT=10

# Web 与检索参数
JUDIAN_HOST=127.0.0.1
JUDIAN_PORT=8766
JUDIAN_USER=demo
JUDIAN_EVIDENCE_TOP_N=8
JUDIAN_RECALL_LIMIT=30
JUDIAN_RRF_K=60
JUDIAN_MIN_VECTOR_SIM=0.28
JUDIAN_MIN_COVERAGE=0.20
JUDIAN_MAX_UPLOAD_MB=20
JUDIAN_LOG_QUERIES=true
