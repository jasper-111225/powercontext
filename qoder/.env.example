# 「据典」配置样例。复制为 .env 后按需修改；不要提交真实密钥。

# ---- seekdb（MySQL 协议）----------------------------------------------
JUDIAN_DB_HOST=127.0.0.1
JUDIAN_DB_PORT=2881
JUDIAN_DB_USER=root
JUDIAN_DB_PASSWORD=
JUDIAN_DB_NAME=judian

# ---- 向量模型（Ollama，OpenAI 兼容）------------------------------------
JUDIAN_EMBED_BASE=http://127.0.0.1:11434/v1
JUDIAN_EMBED_MODEL=qwen3-embedding:0.6b
JUDIAN_EMBED_DIM=1024
JUDIAN_EMBED_BATCH=8

# ---- 生成模型（可换成任意 OpenAI 兼容服务）-----------------------------
JUDIAN_LLM_BASE=http://127.0.0.1:11434/v1
JUDIAN_LLM_MODEL=qwen2.5:0.5b
JUDIAN_LLM_TIMEOUT=90

# ---- PowerContext（记忆）----------------------------------------------
JUDIAN_POWERCONTEXT_URL=http://127.0.0.1:17430
JUDIAN_POWERCONTEXT_TOKEN=judian-local-token
JUDIAN_POWERCONTEXT_SCOPE=judian-learning

# ---- Web 服务 ----------------------------------------------------------
JUDIAN_HOST=127.0.0.1
JUDIAN_PORT=8766
JUDIAN_USER=demo
